@page "/alquiler/crearalquiler"
@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CrearAlquiler> logger
@inject AlquilerStateContainer alquilerState


<h3>Crear alquiler</h3>

@* rental is the object that will be edited thanks to the form *@
<EditForm Model="alquiler" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.NombreCliente" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.ApellidoCliente" class="form-control" id="Surname" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="alquiler.DireccionEnvio" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@alquiler.MetodoDePago" id="PaymentMethod">
                    <option value="@MetodoDePago.TarjetaCredito" default> CreditCard</option>
                    <option value="@MetodoDePago.PayPal"> PayPal</option>
                    <option value="@MetodoDePago.Efectivo"> Cash</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Rent your movies
                </button>
            </div>
        </div>
    </div>
    <h4>Rental detail</h4>
    <p><b>Date from:</b> @alquiler.FechaInicio.ToString("dd/MM/yyyy") <b>to:</b> @alquiler.FechaFin.ToString("dd/MM/yyyy")</p>
    <p>
        <b>Total price:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyRentalItems" id="ModifyMovies">
            Modify movies
        </button>
    </p>
    
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfRentalItems">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Price For Renting</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in alquiler.AlquilarItems) {
                    <tr id="MovieData_@item.AlquilerId">
                        <td>@item.AlquilerId</td>
                        <td>@item.HerramientaId</td>
                        <td>@item.Precio</td>
@*              CORREGIR DESPUÉS     <td><InputText @bind-Value="item.Description" class="form-control" id="@($"description_{item.MovieID}")" /></td> *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <Dialog Caption="Rental movies"
    Message="Do you want to proceed to rent the selected movies?"
    OnClose="@OnDialogClose"
    Type=Dialog.Category.SaveNot>
    </Dialog>
}
@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;

    public CrearAlquiler()
    {
    }
    
    public CrearAlquiler(NavigationManager navigation)
    {
        this.navigation = navigation;
    }

    private decimal TotalCost { 
        get {
            int days = (alquiler.FechaFin.DateTime - alquiler.FechaInicio.DateTime).Days;
            double price = alquiler.AlquilarItems.Sum(ri => ri.Precio * days);
            return Convert.ToDecimal(price);
        }
    }

    private void ModifyRentalItems()
    {
        navigation.NavigateTo("/rental/selectmoviesforrental");
    }
    private AlquilerCrearDTO alquiler => alquilerState.Alquiler;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (alquiler.AlquilarItems.Count > 0)
            {
                try
                {
                    var rented = await apiclient.CreateAlquilerAsync(alquiler);
                    alquilerState.RentalProcessed();
                    navigation.NavigateTo($"/rental/detailrental/?RentalID={rented.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }

    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    alquiler.NombreCliente = user.Identity.Name;
                }
            }
            alquiler.NombreCliente = alquiler.NombreCliente == null ? "" : alquiler.NombreCliente;
            alquiler.ApellidoCliente = alquiler.ApellidoCliente == null ? "" : alquiler.ApellidoCliente;
            alquiler.DireccionEnvio = alquiler.DireccionEnvio == null ? "" : alquiler.DireccionEnvio;

        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
