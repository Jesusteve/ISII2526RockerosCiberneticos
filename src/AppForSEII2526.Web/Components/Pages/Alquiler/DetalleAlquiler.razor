@page "/alquiler/detallealquiler"


@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient

<h3>Detalles de alquiler</h3>

@*@attribute [Authorize]*@

@if (alquiler == null)
{
    <p>@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Nombre y Apellidos</th>
            <td id="NameSurname">@alquiler.NombreCliente @alquiler.ApellidoCliente</td>
        </tr>
        <tr>
            <th>Dirección</th>
            <td id="DeliveryAddress">@alquiler.DireccionEnvio</td>
        </tr>
        <tr>
            <th>Método de Pago</th>
            <td id="PaymentMethod">@alquiler.MetodoDePago</td>
        </tr>
        <tr>
            <th>Fecha de alquiler</th>
            <td id="RentalDate">@alquiler.FechaAlquiler.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
        <tr>
            <th>Periodo de alquiler</th>
            <td id="RentalPeriod">@alquiler.FechaInicio.DateTime.ToString("dd/MM/yyyy") - @alquiler.FechaFin.DateTime.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>

    <h4>Herramientas alquiladas</h4>

    <table class="table" id="HerrAlquiladas">
        <thead>
            <tr>
                <th scope="col">ID Herramienta</th>
                <th scope="col">Nombre</th>
                <th scope="col">Cantidad</th>
                <th scope="col">Precio</th>
                <th scope="col">ID Alquiler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AlquilarItemDTO item in alquiler.AlquilarItems)
            {
                <tr id="RentalItem_@item.AlquilerId">
                    <td>@item.HerramientaId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Precio €</td>
                    <td>@item.AlquilerId</td>
                </tr>
            }
        </tbody>
        <tfoot>
            @*colspan es usado para que no se solapen dos columnas*@
        <th scope="row" colspan="2" class="text-end">Precio Total</th>
        <td id="TotalPrice">@alquiler.PrecioTotal €</td>
        </tfoot>

    </table>

}

