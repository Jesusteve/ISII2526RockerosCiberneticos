@page "/rental/selectmoviesforrental"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient  apiclient
@inject ILogger<SelecionarHerramientasComprar> logger
@inject CompraStateContainer compraState
@inject NavigationManager navigation

@attribute [Authorize]
<h3>Select Herramientas For Compra</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Title</span>
                        <input type="text" id="inputTitle" @bind=herramientaNombre class="form-control" placeholder="Title" aria-label="Title" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Genre</span>
                        <select class="form-select" aria-label="Default select" @bind="herramientaFabricanteSelected" id="selectFabricante">
                            <option value="All" selected>All</option>
                            @foreach (string genreName in fabricanteNames)
                            {
                                <option value="@genreName" id="genreNameSelected_@genreName">@genreName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">From</span>
                        <InputDate @bind-Value="@fecha" id="fecha" />
                    </div>
                </div>
               
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchHerramientas id="searchMovies">Buscar Herrramientas</button>
                </div>

            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Cargando herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfMovies">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fabricante</th>
                                    <th>Material</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herr in herramientas)
                                {
                                    <tr id="HerramientaData_@herr.Nombre">
                                        <td>@herr.Nombre</td>
                                        <td>@herr.Fabricante</td>
                                        <td>@herr.Material</td>
                                        <td>@herr.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaToCompra_@herr.Nombre" @onclick="@(() => AddCompra(herr))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@hideRentingCart">
            <div class="row">
                <h3>Shopping Cart</h3>
            </div>
            @foreach (CompraItemDTO item in compra.CompraItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeCompra_@item.Nombre" @onclick="@(() => RemoveCompraItem(item))">x @item.Nombre - @item.Precio€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="purchaseMovieButton" @onclick=@CompraHerramientas>Compra herramientas</button>
            </div>
        </div>

    </div>

</div>

@code {
    private string herramientaFabricanteSelected;
    private ICollection<string>? fabricanteNames = new List<string>();
    private bool hideRentingCart { get { return compra.CompraItems.Count == 0; } }
    private ICollection<HerramienParaComprarDTO> herramientas;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string herramientaNombre { get; set; }
    private string herramientaFabricante { get; set; }
    private float herramientaPrecio { get; set; }
  
    private DateTime fecha
    {
        get { return fecha; }
        set
        {
            if (fecha != value)
            {
                //the rentingcart is cleared to ensure that only movies available for the selected period are selected
                fecha = value;
                compra.FechaCompra = DateTime.SpecifyKind(fecha, DateTimeKind.Utc);
                compraState.ClearRentingCart();

            }
        }
    }
    private float precioTotal
    {
        get
        {
            float total = 0;
            foreach (var item in compra.CompraItems)
            {
                total += item.Precio * item.Cantidad ;
            }
            return total;
        }
    }

   
    private CompraForCreateDTO compra => compraState.Compra;

    private bool hiddenRentingCart = true;

    private void AddCompra(HerramienParaComprarDTO compra)
    {
        compraState.AddHerramientaToCompra(compra);
    }

    private void RemoveCompraItem(CompraItemDTO item)
    {
        compraState.RemoveHerramientaItemToCompra(item);
        if (compra.CompraItems.Count == 0) hiddenRentingCart = true;
    }

    public async void SearchHerramientas()
    {

        
        herramientaNombre = string.IsNullOrEmpty(herramientaNombre) ? null : herramientaNombre;
        herramientaPrecio = herramientaPrecio == 0 ? 0 : herramientaPrecio;

       
       
        try
        {
            herramientas = await apiclient.GetHerramienParaComprarAsync(herramientaNombre, herramientaPrecio);
            errors = "";

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {

        try
        {
         //   fabricanteNames = await apiclient.GetFabricantesAsync(null);
        }
        catch (ApiException ex)
        {
            if (fabricanteNames == null) fabricanteNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetGenresAsync service");
        }

        //the type of RentalDateFrom is DateTimeOffset, it is required a conversion
        //https://learn.microsoft.com/es-es/dotnet/standard/datetime/converting-between-datetime-and-offset
        fecha = (fecha == new DateTime(1, 1, 1)) ?
            DateTime.SpecifyKind(DateTime.Today.AddDays(1), DateTimeKind.Utc)
            : fecha;
        compra.FechaCompra = fecha;

        

        SearchHerramientas();

        // return base.OnInitializedAsync();
    }

    private void CompraHerramientas()
    {
        navigation.NavigateTo("/rentals/createrental");
    }

}