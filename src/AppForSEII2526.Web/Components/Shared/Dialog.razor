<h3>Dialog</h3>
<div class="modal fade show" id="DialogOKSaveDelete" style="display:block; background-color: rgba(10,10,10,.8);" aria-modal="true" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@Caption</h4>
                <button type="button" class="close"
                        @onclick="@Cancel">
                    &times;
                </button>
            </div>
            <div class="modal-body">
                <p>@Message</p>
            </div>
            <div class="modal-footer">
                @switch (Type) {
                    case Category.Okay:
                        <button type="button" class="btn btn-primary" @onclick=@Ok id="Button_DialogOK">
                            OK
                        </button>
                        break;
                    case Category.SaveNot:
                        <button type="button" class="btn btn-primary" @onclick=@Ok id="Button_DialogOK">
                            Guardar
                        </button>
                        <button type="button" class="btn btn-warning" @onclick="@Cancel" id="Button_DialogCancel">
                            No guardar
                        </button>
                        break;
                    case Category.DeleteNot:
                        <button type="button" class="btn btn-danger" @onclick=@Ok id="Button_DialogOK">
                            Borrar
                        </button>
                        <button type="button" class="btn btn-warning" @onclick="@Cancel" id="Button_DialogCancel">
                            No borrar
                        </button>
                        break;
                }
            </div>
        </div>
    </div>
</div>

@code {
    //Este parámetro se usará para mostrar un título en el cuadro de diálogo 
    [Parameter] public string Caption { get; set; }

    //Este parámetro se usará para mostrar un mensaje en el cuadro de diálogo
    [Parameter] public string Message { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    //Este parámetro se usará para definir el tipo de cuadro de diálogo
    [Parameter] public Category Type { get; set; }

    //Cancela la operación y devolverá false
    private Task Cancel()
    {
        return OnClose.InvokeAsync(false);
    }

    //Devuelve true para confirmar la operación
    private Task Ok()
    {
        return OnClose.InvokeAsync(true);
    }
    public enum Category
    {
        Okay,
        SaveNot,
        DeleteNot
    }
}
